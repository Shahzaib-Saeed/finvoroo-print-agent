{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Finvoroo Print Agent",
  "version": "1.1.2",
  "identifier": "com.finvoroo.print-agent",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Finvoroo Print Agent",
        "width": 560,
        "height": 720,
        "resizable": true,
        "visible": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://127.0.0.1:17392"
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "Finvoroo Print Agent"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "publisher": "Finvoroo",
    "homepage": "https://finvoroo.com",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "startMenuFolder": "Finvoroo",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    },
    "shortDescription": "Silent printing for Finvoroo ERP",
    "longDescription": "Local print agent that sends jobs directly to Windows printers (including Zebra GK420d) without a browser print dialog. Install on each till PC — not on the Laravel server.",
    "category": "Utility",
    "copyright": "Finvoroo"
  }
}
